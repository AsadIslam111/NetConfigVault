# ==============================================================
# NetConfigVault Environment & Credential Configuration
# Copy this file to .env and configure your credentials
# ==============================================================

# Default SSH Credentials (used across devices unless overridden)
NCV_SSH_USERNAME=admin
NCV_SSH_PASSWORD=your_secure_password_here

# Cisco enable password / secret (optional)
NCV_ENABLE_SECRET=cisco_enable_secret_here

# SSH private key authentication (optional alternative to password)
# NCV_SSH_KEY_PATH=~/.ssh/id_rsa

# Per-Device Credential Overrides (optional)
# Syntax: NCV_<DEVICE_HOSTNAME_UPPERCASE>_USERNAME / PASSWORD
# NCV_EDGE_GW_01_USERNAME=mikrotik_admin
# NCV_EDGE_GW_01_PASSWORD=mikrotik_password

# Notifications (Tier 2)
# NCV_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# NCV_SMTP_SERVER=smtp.gmail.com
# NCV_ALERT_EMAIL=netops@example.com

